<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// CT 2-1-2 Defensive Split module.
	// Assigns 5 CT defensive roles:
	//   - 2 CTs to Site A
	//   - 2 CTs to Site B (B Anchor & B Rotate via scripted setpos/setang)
	//   - 1 CT to Mid / Rotator
	type = "selector"
	children =
	[
		// CT Role 1: Site A Anchor 1
		{
			type = "decorator_try_lock"
			domain = "'CtSplitA1'"
			child =
			{
				type = "sequencer"
				children =
				[
					{
						type = "action_equip_weapon"
						weapon = "BEST"
					},
					{
						type = "action_choose_random_waypoint_within_radius"
						origin = "412.27 -1648.28 -160.13"
						radius = 600
						output = "CtTargetAreaA1"
					},
					{
						type = "action_move_to"
						destination = "CtTargetAreaA1"
						movement_type = "BT_ACTION_MOVETO_RUN"
						route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
					},
					{
						type = "action_wait"
						wait_time_min = 14.0
						wait_time_max = 18.0
					}
				]
			}
		},
		// CT Role 2: Site A Anchor 2
		{
			type = "decorator_try_lock"
			domain = "'CtSplitA2'"
			child =
			{
				type = "sequencer"
				children =
				[
					{
						type = "action_equip_weapon"
						weapon = "BEST"
					},
					{
						type = "action_choose_random_waypoint_within_radius"
						origin = "230.15 -2280.08 24.00"
						radius = 600
						output = "CtTargetAreaA2"
					},
					{
						type = "action_move_to"
						destination = "CtTargetAreaA2"
						movement_type = "BT_ACTION_MOVETO_RUN"
						route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
					},
					{
						type = "action_wait"
						wait_time_min = 14.0
						wait_time_max = 18.0
					}
				]
			}
		},
		// CT Role 3: Site B Anchor (Scripted setpos/setang)
		{
			type = "decorator_try_lock"
			domain = "'CtSplitB1'"
			child =
			{
				type = "subtree"
				file = "scripts/ai/ln/modules/bt_b_anchor.kv3"
				name = "CtBAnchor"
			}
		},
		// CT Role 4: Site B Rotate (Scripted setpos/setang)
		{
			type = "decorator_try_lock"
			domain = "'CtSplitB2'"
			child =
			{
				type = "subtree"
				file = "scripts/ai/ln/modules/bt_b_rotate.kv3"
				name = "CtBRotate"
			}
		},
		// CT Role 5: Mid / Rotator
		{
			type = "decorator_try_lock"
			domain = "'CtSplitMid'"
			child =
			{
				type = "sequencer"
				children =
				[
					{
						type = "action_equip_weapon"
						weapon = "BEST"
					},
					{
						type = "action_choose_random_waypoint_within_radius"
						origin = "268.00 -13.74 -135.66"
						radius = 500
						output = "CtTargetMidArea"
					},
					{
						type = "action_move_to"
						destination = "CtTargetMidArea"
						movement_type = "BT_ACTION_MOVETO_WALK"
						route_type = "BT_ACTION_MOVETO_SAFEST_ROUTE"
					},
					{
						type = "action_wait"
						wait_time_min = 14.0
						wait_time_max = 18.0
					}
				]
			}
		},
		// CT Fallback
		{
			type = "subtree"
			file = "scripts/ai/ln/modules/bt_b_rotate.kv3"
			name = "CtFallback"
		}
	]
}
