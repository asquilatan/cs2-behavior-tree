<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	type = "sequencer"
	children =
	[
		{
			type = "action_equip_weapon"
			weapon = "BEST"
		},
		{
			type = "decorator_random_int"
			min = 0
			max = 0
			output = "BombSiteIndex"
			child =
			{
				type = "action_choose_bomb_site_area"
				input = "BombSiteIndex"
				output = "BombSiteArea"
			}
		},
		{
			type = "action_choose_random_waypoint"
			input = "BombSiteArea"
			output = "TargetArea"
		},
		{
			type = "action_move_to"
			destination = "TargetArea"
			movement_type = "BT_ACTION_MOVETO_RUN"
			route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
			arrival_epsilon = 1000
		},
		// Hold: settle behind the site, then wait and watch
		{
			type = "selector"
			children =
			[
				{
					type = "sequencer"
					children =
					[
						{
							type = "action_hide"
							max_range = 1500
							output = "HidingSpot"
						},
						{
							type = "action_move_to"
							destination = "HidingSpot"
							movement_type = "BT_ACTION_MOVETO_WALK"
							route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
							arrival_epsilon = 50
						}
					]
				},
				// Watch the last-known enemy position (memorized via sight/noise)
				// instead of staring into the site while nothing is visible.
				{
					type = "decorator_ranker_dist"
					input = "LongTermMemory"
					child =
					{
						type = "decorator_picker_max_score"
						input = "LongTermMemory"
						child =
						{
							type = "condition_is_empty"
							input = "LongTermMemory"
							negated = 1
							child =
							{
								type = "decorator_repeat"
								child =
								{
									type = "action_aim"
									input = "LongTermMemory"
								}
							}
						}
					}
				},
				// Fallback: hold in place (action_wait is a no-op in this engine)
				{
					type = "decorator_succeed"
				}
			]
		}
	]
}