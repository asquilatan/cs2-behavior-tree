<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// Per-bot random site hunt: pick a random bombsite, a random waypoint inside
	// it, then push (run) or lurk (walk) there. Shared by:
	//  - the T hunt fallback in ln/bt_default.kv3
	//  - the CT spread-round fallback in ln/modules/bt_ct_hunt.kv3 (used while
	//    GroupId tokens are not yet live, so the team doesn't 5-stack one site)
	type = "sequencer"
	children =
	[
		{
			type = "action_equip_weapon"
			weapon = "BEST"
		},
		{
			type = "decorator_random_int"
			min = 0
			max = 1
			output = "BombSiteIndex"
			child =
			{
				type = "action_choose_bomb_site_area"
				input = "BombSiteIndex"
				output = "HuntAreas"
			}
		},
		{
			type = "action_choose_random_waypoint"
			input = "HuntAreas"
			output = "TargetHuntArea"
		},
		// 50/50 chance to push (run) or lurk (walk)
		{
			type = "decorator_random_int"
			min = 0
			max = 1
			output = "LurkDecision"
			child =
			{
				type = "selector"
				children =
				[
					// Case 0: Lurk (Walk)
					{
						type = "sequencer"
						children =
						[
							{
								type = "condition_is_equal"
								source = "LurkDecision"
								destination = 0
							},
							{
								type = "action_move_to"
								destination = "TargetHuntArea"
								movement_type = "BT_ACTION_MOVETO_WALK"
								route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
							}
						]
					},
					// Case 1: Push (Run)
					{
						type = "action_move_to"
						destination = "TargetHuntArea"
						movement_type = "BT_ACTION_MOVETO_RUN"
						route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
					}
				]
			}
		}
	]
}
