<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// CT round tactics, rebuilt without RoundNumber (dead in this engine:
	// every RoundNumber gate silently failed and the selector collapsed to
	// the round-13+ B-push fallback — that was the "always B" bug).
	//
	// All gates use AccountBalance only, which is a documented reserved
	// variable proven working by ln/modules/bt_buy_coordinated.kv3.
	// The bunch plan (one-site stack) is PARKED until a working per-round
	// alternation signal exists; for now every tier spreads 2-1-2.
	//
	// Role assignment inside bt_ct_hunt_spread.kv3 uses decorator_try_lock
	// (no GroupId / token service): deterministic 2 x A-hold, 2 x B-hold,
	// 1 x B-flank. Random-site hunt is the per-bot fallback.
	type = "selector"
	children =
	[
		// Pistol / eco: spread, protect both sites
		{
			type = "condition_is_less"
			source = "AccountBalance"
			destination = 1800
			child =
			{
				type = "selector"
				children =
				[
					{
						type = "subtree"
						file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_spread.kv3"
						name = "CtHuntSpread"
					},
					{
						type = "subtree"
						file = "scripts/ai/ln_mirage/modules/bt_hunt_random_site.kv3"
						name = "CtHuntRandomSite"
					}
				]
			}
		},
		// Full buy: standard 2-1-2 spread
		{
			type = "condition_is_greater_equal"
			source = "AccountBalance"
			destination = 3500
			child =
			{
				type = "selector"
				children =
				[
					{
						type = "subtree"
						file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_spread.kv3"
						name = "CtHuntSpread"
					},
					{
						type = "subtree"
						file = "scripts/ai/ln_mirage/modules/bt_hunt_random_site.kv3"
						name = "CtHuntRandomSite"
					}
				]
			}
		},
		// Half-buy: spread for now (bunch plan parked — see header comment)
		{
			type = "selector"
			children =
			[
				{
					type = "subtree"
					file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_spread.kv3"
					name = "CtHuntSpread"
				},
				{
					type = "subtree"
					file = "scripts/ai/ln_mirage/modules/bt_hunt_random_site.kv3"
					name = "CtHuntRandomSite"
				}
			]
		}
	]
}
