<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// 2-1-2 role assignment WITHOUT decorator_token_service (that node is
	// Guardian-mode only and never issues GroupId in a regular competitive
	// match, so GroupId-based routing never fires there).
	//
	// Each role is a decorator_try_lock on its own domain: at most one bot can
	// execute a role's subtree at a time. Bots evaluate this selector in stable
	// tick order, so every tick the first bot re-grabs RoleA1, the second
	// RoleA2, etc. -> deterministic 2 x A-hold, 2 x B-hold, 1 x B-flank with no
	// shared state. The lock is held while the role subtree executes (move +
	// hold), so an assignment is sticky for the whole round; if a role-holder
	// dies, another bot picks the role up on the next tick.
	type = "selector"
	children =
	[
		{
			type = "decorator_try_lock"
			domain = "'RoleA1'"
			child =
			{
				type = "subtree"
				file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_site_a_hold.kv3"
				name = "ct1"
			}
		},
		{
			type = "decorator_try_lock"
			domain = "'RoleA2'"
			child =
			{
				type = "subtree"
				file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_site_a_hold.kv3"
				name = "ct2"
			}
		},
		{
			type = "decorator_try_lock"
			domain = "'RoleB1'"
			child =
			{
				type = "subtree"
				file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_site_b_hold.kv3"
				name = "ct3"
			}
		},
		{
			type = "decorator_try_lock"
			domain = "'RoleB2'"
			child =
			{
				type = "subtree"
				file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_site_b_hold.kv3"
				name = "ct4"
			}
		},
		{
			type = "decorator_try_lock"
			domain = "'RoleBFlank'"
			child =
			{
				type = "subtree"
				file = "scripts/ai/ln_mirage/modules/bt_ct_hunt_flank_b.kv3"
				name = "ct5"
			}
		}
	]
}
