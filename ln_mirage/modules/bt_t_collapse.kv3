<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// Mid-round collapse. The first bot to reach this module takes the
	// 'TCollapse' lock, waits ~45-60s (no engine round clock, so this is a
	// timed approximation), picks a random site (A=0, B=1), and records it
	// in the shared global flag 'SitePicked'. All other bots, on later
	// ticks, see 'SitePicked' non-empty and fall through to the execute.
	//
	// Uses action_set_global_counter (not action_set_global_flag) so the
	// value persists for the round without an expiry race; the execute
	// reads it via condition_is_empty + action_choose_bomb_site_area.
	//
	// Fallback if the shared flag doesn't work cross-bot: each bot rolls the
	// same deterministic site at the same time (see plan Risks).
	type = "selector"
	children =
	[
		{
			type = "decorator_try_lock"
			domain = "'TCollapse'"
			child =
			{
				type = "sequencer"
				children =
				[
					{
						// The "mid-round" delay (seconds). Tune in-game.
						type = "action_wait"
						wait_time_min = 45
						wait_time_max = 60
					},
					{
						// Pick a random site: 0 = A, 1 = B.
						type = "decorator_random_int"
						min = 0
						max = 1
						output = "CollapseSiteIndex"
						child =
						{
							type = "action_choose_bomb_site_area"
							input = "CollapseSiteIndex"
							output = "CollapseSiteArea"
						}
					},
					{
						// Record the site in the shared global flag.
						type = "action_set_global_counter"
						input_name = "'SitePicked'"
						input_value = 1
					}
				]
			}
		},
		{
			// Not the collapser: fall through (other bots read SitePicked).
			type = "decorator_succeed"
		}
	]
}
