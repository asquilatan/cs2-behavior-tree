<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// T default, B push (1 of 2). Runs to a HARDCODED mirage position at the
	// B approach and holds there. arrival_epsilon 1000 (CT holds) makes bots
	// stop mid-site, so we use a tight epsilon and a specific waypoint.
	//
	// Position: T underpass (-1047.967773 -226.494629 -304.000000) — the
	// safe B chokepoint from the T side, just before T apps.
	type = "sequencer"
	children =
	[
		{
			type = "action_equip_weapon"
			weapon = "BEST"
		},
		{
			type = "action_move_to"
			destination = "-1047.967773 -226.494629 -304.000000"
			movement_type = "BT_ACTION_MOVETO_RUN"
			route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
			arrival_epsilon = 50
		},
		// Hold at the entrance: watch the last-known enemy, else stand tight.
		{
			type = "decorator_ranker_dist"
			input = "LongTermMemory"
			child =
			{
				type = "decorator_picker_max_score"
				input = "LongTermMemory"
				child =
				{
					type = "condition_is_empty"
					input = "LongTermMemory"
					negated = 1
					child =
					{
						type = "decorator_repeat"
						child =
						{
							type = "action_aim"
							input = "LongTermMemory"
						}
					}
				}
			}
		},
		{
			type = "decorator_succeed"
		}
	]
}
