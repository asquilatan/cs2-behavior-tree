<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// Per-bot random site hunt: pick a random bombsite, a random waypoint inside
	// it, RUN there, then hold in place (pause) at the waypoint instead of
	// instantly re-rolling a new site. Shared by:
	//  - the T hunt fallback in ln/bt_default.kv3
	//  - the CT hunt fallback (currently the CT diagnostic path)
	type = "sequencer"
	children =
	[
		{
			type = "action_equip_weapon"
			weapon = "BEST"
		},
		{
			type = "decorator_random_int"
			min = 0
			max = 1
			output = "BombSiteIndex"
			child =
			{
				type = "action_choose_bomb_site_area"
				input = "BombSiteIndex"
				output = "HuntAreas"
			}
		},
		{
			type = "action_choose_random_waypoint"
			input = "HuntAreas"
			output = "TargetHuntArea"
		},
		// RUN to the site (no more random walk/lurk)
		{
			type = "action_move_to"
			destination = "TargetHuntArea"
			movement_type = "BT_ACTION_MOVETO_RUN"
			route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
		},
		// HOLD / pause once in position: keep the subtree running at the
		// waypoint so we do NOT instantly roll a new destination. Watch the
		// last-known enemy, otherwise stand still. A higher-priority branch
		// (attack/investigate) still interrupts this from bt_default.
		{
			type = "decorator_repeat"
			child =
			{
				type = "selector"
				children =
				[
					{
						type = "decorator_ranker_dist"
						input = "LongTermMemory"
						child =
						{
							type = "decorator_picker_max_score"
							input = "LongTermMemory"
							child =
							{
								type = "condition_is_empty"
								input = "LongTermMemory"
								negated = 1
								child =
								{
									type = "decorator_repeat"
									child =
									{
										type = "action_aim"
										input = "LongTermMemory"
									}
								}
							}
						}
					},
					{
						type = "decorator_succeed"
					}
				]
			}
		}
	]
}