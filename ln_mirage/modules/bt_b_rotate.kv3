								destination = 20
								child =
								{
									type = "sequencer"
									children =
									[
										{
											type = "action_move_to"
											destination = "-1632.333862 583.966919 -104.000000"
											movement_type = "BT_ACTION_MOVETO_RUN"
											route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
										},
										{
