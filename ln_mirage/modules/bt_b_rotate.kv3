							},
							{
								type = "condition_is_equal"
								source = "PosChoice"
								destination = 21
								child =
								{
									type = "sequencer"
									children =
									[
										{
											type = "action_move_to"
											destination = "-1591.727783 625.308228 -104.000000"
											movement_type = "BT_ACTION_MOVETO_RUN"
											route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
										},
										{
											type = "action_look_at"
											input_angles = "1.187985 -50.095425 0.000000"
										},
										{
											type = "action_wait"
											wait_time_min = 14.0
											wait_time_max = 18.0
										}
									]
								}
							}
						]
					},
					// Utility chain at cycle end (delay = the 14-18s hold, ~22-26s into
					// the round): a sequencer, so every owned utility is thrown
					// back-to-back in one decision - molly -> nade at -1515.54, then
					// flash at -1319.87. Lineups from mirage_utility_lineups.md
					// (B Rotate section).
					{
						type = "decorator_succeed"
						child =
						{
