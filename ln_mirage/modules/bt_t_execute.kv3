<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// Mid-round execute. Runs once 'SitePicked' is set (global flag from
	// bt_t_collapse). The team traverses a known-safe scripted path into the
	// chosen site, the designated thrower sets up utility (flash pop), then
	// everyone commits into the site.
	//
	// Safe paths (Mirage), the connector between sites is always
	// A <-> T spawn <-> B:
	//   Exec A: T mid -> T spawn -> A-main -> A Palace
	//   Exec B: T mid -> T spawn -> T underpass -> T apps
	//
	// The site (A/B) is rolled ONCE via decorator_random_int and used for
	// BOTH the navmesh area AND the route module, so the team's route and
	// destination always agree. (SitePicked is just a go-signal = 1.)
	type = "selector"
	children =
	[
		// Only execute once a site has been picked (shared global flag).
		{
			type = "condition_is_empty"
			global = 1
			input = "SitePicked"
			negated = 1
			child =
			{
				type = "sequencer"
				children =
				[
					// Roll the site once: 0 = A, 1 = B.
					{
						type = "decorator_random_int"
						min = 0
						max = 1
						output = "ExecSiteIndex"
						child =
						{
							type = "action_choose_bomb_site_area"
							input = "ExecSiteIndex"
							output = "ExecSiteArea"
						}
					},
					// Take the matching safe route into the site.
					{
						type = "selector"
						children =
						[
							{
								type = "condition_is_equal"
								source = "ExecSiteIndex"
								destination = 0
								child =
								{
									type = "subtree"
									file = "scripts/ai/ln_mirage/modules/bt_t_execute_a_route.kv3"
									name = "ExecARoute"
								}
							},
							{
								type = "condition_is_equal"
								source = "ExecSiteIndex"
								destination = 1
								child =
								{
									type = "subtree"
									file = "scripts/ai/ln_mirage/modules/bt_t_execute_b_route.kv3"
									name = "ExecBRoute"
								}
							}
						]
					},
					{
						// Set up utility: the designated thrower pops a flash
						// into the site, then everyone commits.
						type = "subtree"
						file = "scripts/ai/ln_mirage/modules/bt_flash_throw.kv3"
						name = "FlashThrow"
					},
					{
						// Commit: run into the site.
						type = "action_choose_random_waypoint"
						input = "ExecSiteArea"
						output = "ExecTarget"
					},
					{
						type = "action_move_to"
						destination = "ExecTarget"
						movement_type = "BT_ACTION_MOVETO_RUN"
						route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
					}
				]
			}
		},
		{
			// No site picked yet (still in default): do nothing.
			type = "decorator_succeed"
		}
	]
}
